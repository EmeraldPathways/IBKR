[Unit]
Description=IBKR Event Contract Workbench outbound bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ibkrbridge
Group=ibkrbridge
WorkingDirectory=/opt/ibkr-bridge
EnvironmentFile=/etc/ibkr-bridge/bridge.env
ExecStart=/opt/ibkr-bridge/venv/bin/python -m app.main
Restart=on-failure
RestartSec=8
TimeoutStopSec=30
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ibkr-bridge /var/log/ibkr-bridge
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
