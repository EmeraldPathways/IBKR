MAX_TOTAL_EXPOSURE_USD=250
MAX_ORDER_SIZE_USD=20
MAX_DAILY_LOSS_USD=30
STARTING_CAPITAL_USD=1000
MIN_ACCOUNT_FLOOR_PERCENT=20
MAX_CONCURRENT_ORDERS=3
MAX_SLIPPAGE_PERCENT=0.015
ALPACA_ENABLED=false
ALPACA_API_KEY=
ALPACA_API_SECRET=
